# Copy this file to .env and update the paths for your environment.
# docker compose up will pick it up automatically.

# Directory containing input CSVs (defaults to the sample data)
DATA_DIR=./data

# Path to the data contract YAML
CONTRACT_PATH=./Contract_rules.yaml

# Spark shuffle partitions — increase for larger datasets (default: 4)
SPARK_SHUFFLE_PARTITIONS=4
